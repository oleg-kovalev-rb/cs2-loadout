# Copy to .env and fill in a real value. .env is gitignored — never commit
# the real secret.

# Shared HMAC secret used to sign/verify the bridge token that lets the React
# dashboard call app_fetcher directly (see app_core/lib/steam/bridge_token.rb
# and app_fetcher/app/controllers/application_controller.rb).
# Generate one with: openssl rand -hex 32
APP_BRIDGE_JWT_SECRET=

# Shared HMAC secret used to sign/verify the admin bridge token that lets the
# admin panel's React island call app_fetcher's Api::Admin:: endpoints
# directly (see app_core/lib/admin/bridge_token.rb and
# app_fetcher/app/controllers/api/admin/application_controller.rb). Distinct
# from APP_BRIDGE_JWT_SECRET above so a per-player token can never pass as an
# admin one. Generate one with: openssl rand -hex 32
APP_ADMIN_BRIDGE_JWT_SECRET=

# Shared HMAC secret used to sign/verify the demo token that lets a
# signed-out visitor's browser call app_fetcher's Api::Demo:: endpoints
# directly (see app_core/lib/demo/bridge_token.rb and
# app_fetcher/app/controllers/api/demo/base_controller.rb). Distinct from
# APP_BRIDGE_JWT_SECRET and APP_ADMIN_BRIDGE_JWT_SECRET so a demo token can
# never pass as a player or admin one. Generate one with:
# openssl rand -hex 32
APP_DEMO_JWT_SECRET=

# Host:port where app_fetcher is reachable from the browser (not the Docker
# network) — app_core embeds this in the dashboard page so the React app
# knows where to send its direct API calls.
APP_FETCHER_PUBLIC_URL=

# Origin app_fetcher's CORS config allows to call it — must match where
# app_core is reachable from the browser.
APP_CORE_ORIGIN=

# Steam Web API key used by app_core/lib/steam/profile_fetcher.rb to fetch
# a signed-in user's real nickname/avatar after login. Optional — if left
# blank, login still works, the dashboard just falls back to a generic
# nickname and a letter-only avatar. Get one at
# https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=
