<% content_for :title, "Inventory" %>

<div class="dash-root">
  <div class="bg-fx" aria-hidden="true"></div>

  <%= render "shared/topbar", active_tab: :inventories %>

  <div
    id="inventory-detail-root"
    data-fetcher-url="<%= ENV.fetch('APP_FETCHER_PUBLIC_URL') %>"
    data-steam-id="<%= params[:steam_id] %>"
    data-nickname="<%= @profile&.nickname %>"
    data-avatar-url="<%= @profile&.avatar_url %>"
  ></div>
</div>

<% content_for :vite_entrypoint do %>
  <%= vite_javascript_tag "inventory-detail.jsx" %>
<% end %>
