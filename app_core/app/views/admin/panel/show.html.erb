<% content_for :title, "AppCore · Admin" %>

<div class="shell">
  <header class="topbar">
    <span class="wordmark">AppCore<span class="dim">/</span>Admin</span>
    <div class="topbar-right">
      <div class="admin-chip">
        <span class="avatar"><%= current_admin_user.email.first.upcase %></span>
        <%= current_admin_user.email %>
      </div>
      <%= button_to admin_session_path, method: :delete, class: "btn" do %>
        Sign out
      <% end %>
    </div>
  </header>

  <div
    id="admin-panel-root"
    data-bridge-token="<%= @bridge_token %>"
    data-fetcher-url="<%= ENV.fetch('APP_FETCHER_PUBLIC_URL') %>"
  ></div>
</div>

<% content_for :vite_entrypoint do %>
  <%= vite_javascript_tag "admin-panel.jsx" %>
<% end %>
