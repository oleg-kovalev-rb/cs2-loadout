<% content_for :title, current_user ? "Dashboard — FLOAT" : "FLOAT" %>

<div class="dash-root">
  <div class="bg-fx" aria-hidden="true"></div>

  <header class="topbar">
    <div class="brand">
      <span class="brand-mark">FLOAT<span>/</span></span>
      <span class="brand-sub">Steam market intelligence</span>
    </div>
    <% if current_user %>
      <div class="profile-group">
        <span class="profile-chip">
          <% if current_user.avatar_url.present? %>
            <%= image_tag current_user.avatar_url, alt: "", class: "avatar-img" %>
          <% else %>
            <span class="avatar" aria-hidden="true"><%= current_user.nickname.to_s.first.presence&.upcase || "?" %></span>
          <% end %>
          <span class="profile-name"><%= current_user.nickname.presence || "Player" %></span>
        </span>
        <a href="#signout-confirm" class="profile-signout" aria-label="Sign out">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M6 3H4a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M10.5 11l3-3-3-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M13.5 8H6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <div id="signout-confirm" class="confirm-overlay">
        <a href="#" class="confirm-overlay-backdrop" aria-hidden="true"></a>
        <div class="confirm-card">
          <p class="confirm-card-text">Sign out of FLOAT?</p>
          <div class="confirm-card-actions">
            <a href="#" class="confirm-cancel">Cancel</a>
            <%= button_to session_path, method: :delete, data: { turbo: false }, class: "confirm-signout" do %>
              Sign out
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </header>

  <% if current_user %>
    <div
      id="dashboard-root"
      data-bridge-token="<%= @bridge_token %>"
      data-fetcher-url="<%= ENV.fetch('APP_FETCHER_PUBLIC_URL') %>"
    ></div>

    <footer class="dash-footer">
      <span class="sync-pill"><span class="pulse-dot" aria-hidden="true"></span>Snapshot loaded just now</span>
      <span class="footer-note">Auto-refresh isn&rsquo;t wired up yet &mdash; reload the page for the latest prices</span>
    </footer>
  <% else %>
    <div class="signin-stage">
      <div class="signin-card">
        <span class="signin-icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path d="M4 17V13.5L9 9.5L13 12.5L20 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M4 20H20" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </span>
        <h1 class="signin-title">See where your inventory stands</h1>
        <p class="signin-subtitle">Connect your Steam account to pull in your CS2 inventory and track what it&rsquo;s worth over time.</p>
        <%= button_to session_path, method: :post, data: { turbo: false }, class: "signin-cta" do %>
          Sign in through Steam
        <% end %>
        <span class="signin-note">We only read your public inventory &mdash; nothing is posted on your behalf.</span>
      </div>
    </div>
  <% end %>
</div>

<% content_for :vite_entrypoint do %>
  <%= vite_javascript_tag "dashboard.jsx" %>
<% end %>
