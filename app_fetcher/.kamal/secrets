# Secrets read by config/deploy.yml. Keep this file reference-only: never
# paste raw credentials here. Values come from the environment (export
# them before running bin/kamal) or from a password manager.
#
# The three JWT secrets must be byte-identical in app_core and
# app_fetcher — see agent/styleguides/deployment.md.

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# This app's own key (app_core and app_fetcher have separate credentials).
# Exported by the deploy environment: locally, `export RAILS_MASTER_KEY=$(cat
# config/master.key)`; in CI it comes from RAILS_MASTER_KEY_CORE/_FETCHER.
RAILS_MASTER_KEY=$RAILS_MASTER_KEY

APP_BRIDGE_JWT_SECRET=$APP_BRIDGE_JWT_SECRET
APP_ADMIN_BRIDGE_JWT_SECRET=$APP_ADMIN_BRIDGE_JWT_SECRET
APP_DEMO_JWT_SECRET=$APP_DEMO_JWT_SECRET

# One value for the app's DB connection and the Postgres accessory
# superuser, so they cannot drift. Export DB_PASSWORD before deploying.
DB_PASSWORD=$DB_PASSWORD
POSTGRES_PASSWORD=$DB_PASSWORD
