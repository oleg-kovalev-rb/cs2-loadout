# Non-secret values for docker compose interpolation inside git hooks.
#
# Hooks (RuboCop / Sorbet / tapioca dsl) never need real secrets or public
# URLs. Supplying deterministic placeholders here means they work in a fresh
# worktree where the gitignored `.env` does not exist.
#
# See script/hook-compose and agent/styleguides/git-hooks.md.
APP_BRIDGE_JWT_SECRET=hook-bridge-secret-not-real
APP_ADMIN_BRIDGE_JWT_SECRET=hook-admin-bridge-secret-not-real
APP_FETCHER_PUBLIC_URL=http://localhost:3001
APP_CORE_ORIGIN=http://localhost:3000
STEAM_WEB_API_KEY=hook-not-used
